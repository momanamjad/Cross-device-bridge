# Espressif ESP-IDF Configuration Defaults for Device Bridge ESP-32S

# 1. Bluetooth Core Configuration
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=n

# 2. Bluetooth Hands-Free Profile (HFP-HF Client)
CONFIG_BT_HFP_CLIENT_ENABLE=y
CONFIG_BT_HFP_WBS_ENABLE=y

# 3. Wi-Fi and Bluetooth 2.4GHz Coexistence
CONFIG_SW_COEXIST_ENABLE=y
CONFIG_SW_COEXIST_PREFERENCE_BALANCE=y

# 4. System Performance & Clock
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_MHZ=240

# 5. FreeRTOS Tick Rate
CONFIG_FREERTOS_HZ=1000
