<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bridge_bg"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:descendantFocusability="beforeDescendants"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:descendantFocusability="beforeDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/backBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="←"
                android:textColor="@color/bridge_accent"
                android:textSize="28sp"
                android:gravity="center"
                android:background="@drawable/badge_status_container"
                android:layout_marginEnd="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="@color/bridge_text"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />
        </LinearLayout>

        <!-- Card 1: Server Configuration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="8dp"
            android:text="SERVER CONFIGURATION"
            android:textColor="@color/bridge_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/bridge_surface"
            app:strokeColor="@color/bridge_card_border"
            app:strokeWidth="1.5dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Backend Server URL"
                    app:boxStrokeColor="@color/bridge_accent"
                    app:hintTextColor="@color/bridge_accent"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/backendUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:textColor="@color/bridge_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Device Identifier"
                    app:boxStrokeColor="@color/bridge_accent"
                    app:hintTextColor="@color/bridge_accent"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/deviceId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/bridge_text" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 2: Security & Authentication -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="8dp"
            android:text="SECURITY &amp; AUTHENTICATION"
            android:textColor="@color/bridge_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/bridge_surface"
            app:strokeColor="@color/bridge_card_border"
            app:strokeWidth="1.5dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Register Secret"
                    app:boxStrokeColor="@color/bridge_accent"
                    app:hintTextColor="@color/bridge_accent"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/bridge_accent"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/registerSecret"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/bridge_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="API Access Token"
                    app:boxStrokeColor="@color/bridge_accent"
                    app:hintTextColor="@color/bridge_accent"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/bridge_accent"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/apiToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/bridge_text" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 3: Features & Services -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="8dp"
            android:text="FORWARDING CONFIGURATION"
            android:textColor="@color/bridge_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/bridge_surface"
            app:strokeColor="@color/bridge_card_border"
            app:strokeWidth="1.5dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/smsEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Forward SMS Messages"
                    android:textColor="@color/bridge_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:thumbTint="@color/bridge_accent"
                    app:trackTint="@color/bridge_surface_elevated" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/bridge_divider"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/callsEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Forward Call Logs &amp; Events"
                    android:textColor="@color/bridge_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:thumbTint="@color/bridge_accent"
                    app:trackTint="@color/bridge_surface_elevated" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 4: Synchronization Status -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/bridge_surface"
            app:strokeColor="@color/bridge_card_border"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/syncStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bridge_text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Configuration Management Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="10dp"
            android:text="Save Configurations"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/bridge_accent"
            android:textColor="@color/bridge_on_accent"
            app:elevation="0dp"
            app:pressedTranslationZ="0dp"
            android:stateListAnimator="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/register"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="8dp"
            android:text="Register This Device"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/bridge_surface"
            app:strokeColor="@color/bridge_card_border"
            app:strokeWidth="1.5dp"
            android:textColor="@color/bridge_text"
            app:elevation="0dp"
            app:pressedTranslationZ="0dp"
            android:stateListAnimator="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/testConnection"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="8dp"
            android:text="Test Server Connection"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/bridge_surface"
            app:strokeColor="@color/bridge_card_border"
            app:strokeWidth="1.5dp"
            android:textColor="@color/bridge_text"
            app:elevation="0dp"
            app:pressedTranslationZ="0dp"
            android:stateListAnimator="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/syncNow"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="8dp"
            android:text="Sync History Now"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/bridge_surface"
            app:strokeColor="@color/bridge_card_border"
            app:strokeWidth="1.5dp"
            android:textColor="@color/bridge_text"
            app:elevation="0dp"
            app:pressedTranslationZ="0dp"
            android:stateListAnimator="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewLogs"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="8dp"
            android:text="View Server Logs"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/bridge_surface"
            app:strokeColor="@color/bridge_card_border"
            app:strokeWidth="1.5dp"
            android:textColor="@color/bridge_warm"
            app:elevation="0dp"
            app:pressedTranslationZ="0dp"
            android:stateListAnimator="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearDb"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="40dp"
            android:text="Clear Local Database"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/status_red"
            android:textColor="@color/bridge_text"
            app:elevation="0dp"
            app:pressedTranslationZ="0dp"
            android:stateListAnimator="@null" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
