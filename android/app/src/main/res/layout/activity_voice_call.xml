<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="24dp"
    tools:context=".ui.VoiceCallActivity">

    <!-- Caller Information -->
    <TextView
        android:id="@+id/tv_caller_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:text="Realme SIM Call"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_call_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Ringing..."
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:textColor="?android:attr/textColorSecondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_caller_number" />

    <!-- Timer -->
    <TextView
        android:id="@+id/tv_call_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="00:00:00"
        android:textAppearance="@style/TextAppearance.Material3.DisplayMedium"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_call_status"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_signal_quality"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Signal: Good (Local WiFi)"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?android:attr/textColorSecondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_call_timer" />

    <!-- Incoming Acceptance Buttons -->
    <LinearLayout
        android:id="@+id/layout_incoming_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintBottom_toTopOf="@id/layout_active_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_reject"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#D32F2F"
            android:text="Decline"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_accept"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#388E3C"
            android:text="Accept"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Active Call Controls -->
    <LinearLayout
        android:id="@+id/layout_active_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mute"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="96dp"
            android:layout_height="64dp"
            android:layout_marginEnd="16dp"
            android:text="Mute" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_hangup"
            android:layout_width="128dp"
            android:layout_height="64dp"
            android:backgroundTint="#D32F2F"
            android:text="Hang Up"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_speaker"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="96dp"
            android:layout_height="64dp"
            android:layout_marginStart="16dp"
            android:text="Speaker" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
