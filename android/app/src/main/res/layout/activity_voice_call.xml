<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bridge_bg"
    android:padding="24dp"
    tools:context=".ui.VoiceCallActivity">

    <!-- Top Kicker Label -->
    <TextView
        android:id="@+id/tv_call_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="CELLULAR VOICE RELAY"
        android:textColor="@color/bridge_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Pulsing Caller Avatar Badge -->
    <FrameLayout
        android:id="@+id/avatar_container"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/avatar_pulse_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_call_header">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@android:drawable/stat_sys_phone_call"
            app:tint="@color/bridge_accent" />
    </FrameLayout>

    <!-- Caller Information -->
    <TextView
        android:id="@+id/tv_caller_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Realme SIM Call"
        android:textColor="@color/bridge_text"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/avatar_container" />

    <TextView
        android:id="@+id/tv_call_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Ringing..."
        android:textColor="@color/bridge_text_secondary"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_caller_number" />

    <!-- Timer -->
    <TextView
        android:id="@+id/tv_call_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="00:00:00"
        android:textColor="@color/bridge_accent"
        android:textSize="38sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_call_status"
        tools:visibility="visible" />

    <!-- Signal Quality Badge -->
    <TextView
        android:id="@+id/tv_signal_quality"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Signal: Good (Local WiFi)"
        android:textColor="@color/bridge_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/badge_status_container"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_call_timer" />

    <!-- Incoming Acceptance Buttons -->
    <LinearLayout
        android:id="@+id/layout_incoming_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintBottom_toTopOf="@id/layout_active_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reject"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/status_red"
            android:text="Decline"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/bridge_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_accept"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/bridge_accent"
            android:text="Accept"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/bridge_on_accent" />
    </LinearLayout>

    <!-- Active Call Controls -->
    <LinearLayout
        android:id="@+id/layout_active_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mute"
            android:layout_width="96dp"
            android:layout_height="58dp"
            android:layout_marginEnd="12dp"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/bridge_surface"
            app:strokeColor="@color/bridge_card_border"
            app:strokeWidth="1.5dp"
            android:textColor="@color/bridge_text"
            android:text="Mute"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_hangup"
            android:layout_width="128dp"
            android:layout_height="58dp"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/status_red"
            android:text="Hang Up"
            android:textStyle="bold"
            android:textColor="@color/bridge_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_speaker"
            android:layout_width="96dp"
            android:layout_height="58dp"
            android:layout_marginStart="12dp"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/bridge_surface"
            app:strokeColor="@color/bridge_card_border"
            app:strokeWidth="1.5dp"
            android:textColor="@color/bridge_text"
            android:text="Speaker"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
