<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bridge_bg"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:descendantFocusability="beforeDescendants"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:descendantFocusability="beforeDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <!-- Top Brand Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="CROSS-DEVICE BRIDGE"
            android:textColor="@color/bridge_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/bridge_text"
                android:textSize="30sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />

            <!-- Live Status Pill Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/badge_status_container"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/status_dot_red" />

                <TextView
                    android:id="@+id/statusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Server Stopped"
                    android:textColor="@color/bridge_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Metrics Dashboard Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="@color/bridge_surface"
            app:strokeColor="@color/bridge_card_border"
            app:strokeWidth="1.5dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="ACTIVE RELAY TELEMETRY"
                    android:textColor="@color/bridge_text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Stat Tile 1: Uptime -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical"
                        android:background="@drawable/card_stat_box"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/statUptime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="@color/bridge_accent"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="UPTIME"
                            android:textColor="@color/bridge_text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />
                    </LinearLayout>

                    <!-- Stat Tile 2: Server IP -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical"
                        android:background="@drawable/card_stat_box"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/statIP"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="@color/bridge_text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="SERVER ENDPOINT"
                            android:textColor="@color/bridge_text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Status Hint -->
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="Tap 'Start Bridge' to begin"
            android:textColor="@color/bridge_text_secondary"
            android:textSize="13sp"
            android:gravity="center" />

        <!-- Hero Start Bridge Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/startBridge"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="12dp"
            android:text="@string/start_bridge"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/bridge_accent"
            android:textColor="@color/bridge_on_accent"
            app:icon="@android:drawable/ic_media_play"
            app:iconGravity="textStart"
            app:iconTint="@color/bridge_on_accent"
            app:elevation="0dp"
            app:pressedTranslationZ="0dp"
            android:stateListAnimator="@null" />

        <!-- Secondary Action 1: Grant Permissions -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/grantPermissions"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="10dp"
            android:text="@string/grant_permissions"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/bridge_surface"
            app:strokeColor="@color/bridge_card_border"
            app:strokeWidth="1.5dp"
            android:textColor="@color/bridge_text"
            app:icon="@android:drawable/ic_lock_lock"
            app:iconGravity="textStart"
            app:iconTint="@color/bridge_accent"
            app:elevation="0dp"
            app:pressedTranslationZ="0dp"
            android:stateListAnimator="@null" />

        <!-- Secondary Action 2: Settings -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/openSettings"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="10dp"
            android:text="@string/open_settings"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/bridge_surface"
            app:strokeColor="@color/bridge_card_border"
            app:strokeWidth="1.5dp"
            android:textColor="@color/bridge_text"
            app:icon="@android:drawable/ic_menu_preferences"
            app:iconGravity="textStart"
            app:iconTint="@color/bridge_accent"
            app:elevation="0dp"
            app:pressedTranslationZ="0dp"
            android:stateListAnimator="@null" />

        <!-- Secondary Action 3: Server Logs -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/mainViewLogs"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="16dp"
            android:text="View &amp; Copy Server Logs"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/bridge_surface"
            app:strokeColor="@color/bridge_card_border"
            app:strokeWidth="1.5dp"
            android:textColor="@color/bridge_text"
            app:icon="@android:drawable/ic_menu_info_details"
            app:iconGravity="textStart"
            app:iconTint="@color/bridge_warm"
            app:elevation="0dp"
            app:pressedTranslationZ="0dp"
            android:stateListAnimator="@null" />

        <!-- QR Code Pairing Card (Anchored below buttons to eliminate layout jump) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/qrCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="@color/bridge_surface_elevated"
            app:strokeColor="@color/bridge_card_border"
            app:strokeWidth="1.5dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PAIR WITH IPHONE"
                    android:textColor="@color/bridge_accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open iOS camera or SMSBridge app to scan"
                    android:textColor="@color/bridge_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp" />

                <!-- High-contrast QR Container Frame -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/qr_frame_bg"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/qrImage"
                        android:layout_width="190dp"
                        android:layout_height="190dp"
                        android:scaleType="fitCenter" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
